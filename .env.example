# =============================================================================
# WIRADEV FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env.local for local frontend development or set these variables
# in the Vercel Project Settings (Environment Variables).

# -----------------------------------------------------------------------------
# 1. API & Backend Reverse Proxy Settings
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL: Base API URL consumed by the frontend client (api-client.ts).
# - In production on Vercel: leave empty ("") or set to your frontend domain / proxy
#   so requests route through Next.js rewrites to eliminate third-party cookie blocking.
# - In local development: "http://localhost:5000" or empty if using local proxy.
NEXT_PUBLIC_API_URL=

# BACKEND_URL: Upstream Express API server destination used by Next.js server-side
# rewrites (next.config.ts) for /api/:path* and /uploads/:path*.
# Production target: https://wirakarsa.infinitelearningstudent.id
# Local development: http://localhost:5000
BACKEND_URL=https://wirakarsa.infinitelearningstudent.id

# -----------------------------------------------------------------------------
# 2. OAuth Provider Credentials (Public Client IDs)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID generated from
# Google Cloud Console (APIs & Services > Credentials).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=159334240812-3k5m6m19u2h5uljs0t5rckauajkovgel.apps.googleusercontent.com

# NEXT_PUBLIC_GITHUB_CLIENT_ID: GitHub OAuth App Client ID created under
# GitHub Settings > Developer settings > OAuth Apps.
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here
